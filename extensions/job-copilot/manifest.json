{
  "manifest_version": 3,
  "name": "CareerTwin Job Copilot",
  "version": "0.1.0",
  "description": "Auto-analyzes supported job detail pages and shows CareerTwin fit guidance.",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.seek.com.au/*",
    "https://boards.greenhouse.io/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "http://localhost:3000/*",
    "https://*.careertwin.com/*"
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CareerTwin Job Copilot"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://www.seek.com.au/*",
        "https://boards.greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*"
      ],
      "js": [
        "shared/messages.js",
      "shared/constants.js",
      "shared/job-payload.js",
      "content/parser-registry.js",
      "content/platform-parsers/linkedin.js",
      "content/platform-parsers/seek.js",
      "content/platform-parsers/greenhouse.js",
      "content/platform-parsers/lever.js",
      "content/platform-parsers/generic.js",
      "content/detect-job-page.js",
      "content/extract-job-page.js",
      "content/index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css",
        "sidepanel/sidepanel.css"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://www.seek.com.au/*",
        "https://boards.greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*"
      ]
    }
  ]
}
